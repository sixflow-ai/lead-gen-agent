# =============================================================================
# Lead Gen Agent - Environment Variables
# =============================================================================
# Copy this to .env and fill in your values

# --- Core APIs ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Lead Sourcing Platforms ---
# Prospeo (email finding + lead search)
PROSPEO_API_KEY=

# Apollo.io (lead database)
APOLLO_API_KEY=

# Blitz (domain-to-contacts)
BLITZ_API_KEY=

# RapidAPI (Google Maps scraping, etc.)
RAPIDAPI_KEY=

# OpenWebNinja (website scraping)
OPENWEBNINJA_API_KEY=

# --- Email Infrastructure ---
# Smartlead
SMARTLEAD_API_KEY=

# Instantly
INSTANTLY_API_KEY=

# --- Verification ---
# MillionVerifier (email verification)
MILLIONVERIFIER_API_KEY=

# --- Google Services ---
# Google Sheets (for deliverables)
GOOGLE_CREDENTIALS_PATH=config/credentials.json
GOOGLE_TOKEN_PATH=config/token.json

# --- Optional ---
# Apify (web scraping)
APIFY_API_TOKEN=

# Dynadot (domain purchasing)
DYNADOT_API_KEY=

# Zapmail (inbox provisioning)
ZAPMAIL_API_KEY=
